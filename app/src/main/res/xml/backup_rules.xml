<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Exclude database files from backup -->
    <exclude domain="database" path="travel_agent_db"/>
    <exclude domain="database" path="travel_agent_db-shm"/>
    <exclude domain="database" path="travel_agent_db-wal"/>
    
    <!-- Exclude temporary files -->
    <exclude domain="file" path="temp/"/>
    <exclude domain="file" path="cache/"/>
    
    <!-- Include shared preferences -->
    <include domain="sharedpref" path="."/>
</full-backup-content>